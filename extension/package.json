{
  "name": "clawd",
  "displayName": "Clawd",
  "description": "VS Code extension for Clawd",
  "version": "1.0.3",
  "publisher": "clawd",
  "repository": "https://github.com/solizardking/extension",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clawd",
    "solana",
    "vscode"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clawd.askMesh",
        "title": "clawd: Ask Mesh"
      },
      {
        "command": "clawd.askMeshSelection",
        "title": "clawd: Ask Mesh about Selection"
      },
      {
        "command": "clawd.meshStatus",
        "title": "clawd: Show Mesh Status"
      },
      {
        "command": "clawd.openMesh",
        "title": "clawd: Open Mesh"
      },
      {
        "command": "clawd.showOutput",
        "title": "clawd: Show Output"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "clawd.askMeshSelection",
          "when": "editorHasSelection",
          "group": "clawd"
        }
      ]
    },
    "configuration": {
      "title": "Clawd",
      "properties": {
        "clawd.meshUrl": {
          "type": "string",
          "default": "",
          "description": "Mesh endpoint. Leave empty to use the bundled default."
        },
        "clawd.meshModel": {
          "type": "string",
          "default": "qwen2.5:1.5b",
          "description": "Default Mesh model id"
        }
      }
    }
  },
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --watch --config webpack.config.js",
    "package": "vsce package --no-rewrite-relative-links",
    "publish": "vsce publish",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.32",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "ts-loader": "9.5.2",
    "typescript": "^5.7.2",
    "webpack": "5.99.9",
    "webpack-cli": "5.1.4"
  }
}
