{
  "mcpServers": {
    "helius": {
      "command": "node",
      "args": ["${CORE_AI_ROOT}/helius-mcp/dist/index.js"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY}",
        "SOLANA_RPC_URL": "${SOLANA_RPC_URL}"
      }
    },
    "solana-mcp": {
      "url": "https://mcp.solana.com/mcp"
    },
    "pump-fun": {
      "command": "node",
      "args": ["${CHESHIRE_TERMINAL_ROOT}/mcp-server/dist/index.js"],
      "env": {
        "SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com",
        "CHESHIRE_TERMINAL_ORIGIN": "https://cheshireterminal.ai",
        "PUBLIC_MPP_URL": "https://mpp.api.cheshireterminal.ai",
        "PUBLIC_MPP_WS_URL": "wss://mpp.api.cheshireterminal.ai/ws",
        "PUBLIC_X402_URL": "https://x402.api.cheshireterminal.ai"
      }
    },
    "cheshire-site": {
      "url": "https://cheshireterminal.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${CHESHIRE_API_KEY}"
      }
    },
    "cheshire-terminal": {
      "url": "https://mcp.scalar.com/mcp/9d212c87-117b-440a-b104-7e6aa02e078e"
    },
    "paybox": {
      "url": "https://api.paybox.sh/mcp"
    },
    "soltrader": {
      "command": "node",
      "args": ["${ZERO_CLAWD_ROOT}/zero-service/src/mcp-soltrader.mjs"]
    },
    "markets": {
      "command": "node",
      "args": ["${ZERO_CLAWD_ROOT}/zero-service/src/mcp-markets.mjs"]
    },
    "perps": {
      "command": "node",
      "args": ["${ZERO_CLAWD_ROOT}/zero-service/src/mcp-perps.mjs"]
    },
    "risk": {
      "command": "node",
      "args": ["${ZERO_CLAWD_ROOT}/zero-service/src/mcp-risk.mjs"]
    },
    "clawd": {
      "command": "node",
      "args": ["${CLAWDBROWSER_ROOT}/zero-service/src/mcp-clawd.mjs"],
      "env": {
        "CLAWDBROWSER_ROOT": "${CLAWDBROWSER_ROOT}"
      }
    },
    "clawd-soltrader": {
      "command": "node",
      "args": ["${CLAWDBROWSER_ROOT}/zero-service/src/mcp-soltrader.mjs"],
      "env": {
        "CLAWDBROWSER_ROOT": "${CLAWDBROWSER_ROOT}"
      }
    },
    "vulcan": {
      "command": "vulcan",
      "args": ["mcp"]
    }
  }
}
