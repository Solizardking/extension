{
  "name": "clawd",
  "displayName": "Clawd",
  "description": "Clawd editor pack for VS Code, Cursor, and VSCodium: bundled Cursor plugins, Solana MCP servers, and agent skills.",
  "version": "1.0.1",
  "publisher": "clawd",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#061117",
    "theme": "dark"
  },
  "homepage": "https://github.com/solizardking/extension",
  "bugs": {
    "url": "https://github.com/solizardking/extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solizardking/extension.git"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clawd",
    "solana",
    "mcp",
    "cursor",
    "vscode"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clawd.askMesh",
        "title": "Clawd: Ask Mesh",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "clawd.askMeshSelection",
        "title": "Clawd: Ask Mesh about Selection"
      },
      {
        "command": "clawd.meshStatus",
        "title": "Clawd: Mesh Status"
      },
      {
        "command": "clawd.openMesh",
        "title": "Clawd: Open Mesh"
      },
      {
        "command": "clawd.installCursorPlugins",
        "title": "Clawd: Install Cursor Plugins",
        "icon": "$(cloud-download)"
      },
      {
        "command": "clawd.openCursorPluginsFolder",
        "title": "Clawd: Open Cursor Plugins Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "clawd.showStatus",
        "title": "Clawd: Show Status"
      },
      {
        "command": "clawd.showOutput",
        "title": "Clawd: Show Output"
      },
      {
        "command": "clawd.openSettings",
        "title": "Clawd: Open Settings"
      },
      {
        "command": "clawd.refresh",
        "title": "Clawd: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "clawd.focusExplorer",
        "title": "Clawd: Focus Explorer"
      },
      {
        "command": "clawd.showPlugin",
        "title": "Clawd: Show Plugin"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clawd",
          "title": "Clawd",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "clawd": [
        {
          "id": "clawd.explorer",
          "name": "Marketplace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clawd.explorer",
        "contents": "Free inference is live on Clawd Mesh. Ask a question, or install Cursor plugins.\n[Ask Mesh](command:clawd.askMesh)\n[Install Cursor Plugins](command:clawd.installCursorPlugins)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clawd.askMesh",
          "when": "view == clawd.explorer",
          "group": "navigation"
        },
        {
          "command": "clawd.refresh",
          "when": "view == clawd.explorer",
          "group": "navigation"
        },
        {
          "command": "clawd.installCursorPlugins",
          "when": "view == clawd.explorer",
          "group": "navigation"
        },
        {
          "command": "clawd.openCursorPluginsFolder",
          "when": "view == clawd.explorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "clawd.showPlugin",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "clawd.askMeshSelection",
          "when": "editorHasSelection",
          "group": "clawd"
        }
      ]
    },
    "configuration": {
      "title": "Clawd",
      "properties": {
        "clawd.meshUrl": {
          "type": "string",
          "default": "https://mesh.x402.wtf",
          "description": "Clawd Mesh base URL for free inference."
        },
        "clawd.meshModel": {
          "type": "string",
          "default": "qwen2.5:1.5b",
          "description": "Default Mesh model. Fast: qwen2.5:1.5b. Solana-tuned: 8bit/solana-clawd-core-ai:latest."
        },
        "clawd.heliusCredential": {
          "type": "string",
          "default": "",
          "description": "Helius credential for bundled MCP servers. Environment override: HELIUS_API_KEY."
        },
        "clawd.solanaRpcUrl": {
          "type": "string",
          "default": "https://api.mainnet-beta.solana.com",
          "description": "Solana RPC URL. Environment override: SOLANA_RPC_URL."
        },
        "clawd.cheshireCredential": {
          "type": "string",
          "default": "",
          "description": "Cheshire Terminal bearer credential. Environment override: CHESHIRE_API_KEY."
        },
        "clawd.xaiCredential": {
          "type": "string",
          "default": "",
          "description": "xAI credential for Clawd Grok MCP. Environment override: XAI_API_KEY."
        },
        "clawd.coreAiRoot": {
          "type": "string",
          "default": "",
          "description": "Path to core-ai (helius-mcp, pump MCP, clawd-grok). Or set CORE_AI_ROOT."
        },
        "clawd.cheshireTerminalRoot": {
          "type": "string",
          "default": "",
          "description": "Path to cheshire-terminal-main. Or set CHESHIRE_TERMINAL_ROOT."
        },
        "clawd.clawdCodeRoot": {
          "type": "string",
          "default": "",
          "description": "Path to Clawd Code CLI checkout. Or set CLAWD_CODE_ROOT."
        },
        "clawd.zeroClawdRoot": {
          "type": "string",
          "default": "",
          "description": "Path to zero-clawd checkout. Or set ZERO_CLAWD_ROOT."
        },
        "clawd.clawdBrowserRoot": {
          "type": "string",
          "default": "",
          "description": "Path to ClawdBrowser checkout. Or set CLAWDBROWSER_ROOT."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "clawd.mcp",
        "label": "Clawd MCP Servers"
      }
    ]
  },
  "scripts": {
    "validate": "node scripts/validate-template.mjs",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "vscode:prepublish": "node scripts/validate-template.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.5"
  }
}
